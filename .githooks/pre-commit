#!/bin/bash
#
# Pre-commit hook: Block commits containing PII patterns
#
# This hook prevents accidentally committing files that contain
# personal identifiable information (PII) like names, email domains,
# or company names that shouldn't be in the public repo.
#

# PII patterns to block (case-insensitive)
PATTERNS=(
    "david"
    "helmus"
    "hellofresh"
)

# Files/paths to exclude from checking (e.g., this hook itself, test fixtures)
EXCLUDE_PATTERNS=(
    ".githooks/"
    ".git/"
)

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Checking for PII patterns..."

# Get list of staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FOUND_PII=0

for FILE in $STAGED_FILES; do
    # Skip excluded paths
    SKIP=0
    for EXCLUDE in "${EXCLUDE_PATTERNS[@]}"; do
        if [[ "$FILE" == *"$EXCLUDE"* ]]; then
            SKIP=1
            break
        fi
    done
    
    if [ $SKIP -eq 1 ]; then
        continue
    fi
    
    # Skip binary files
    if file "$FILE" | grep -q "binary"; then
        continue
    fi
    
    # Check each pattern
    for PATTERN in "${PATTERNS[@]}"; do
        # Case-insensitive search in staged content
        MATCHES=$(git diff --cached "$FILE" | grep -i "$PATTERN" | head -5)
        
        if [ -n "$MATCHES" ]; then
            if [ $FOUND_PII -eq 0 ]; then
                echo ""
                echo -e "${RED}╔════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${RED}║  🚨 PII DETECTED - COMMIT BLOCKED                          ║${NC}"
                echo -e "${RED}╚════════════════════════════════════════════════════════════╝${NC}"
                echo ""
            fi
            FOUND_PII=1
            echo -e "${YELLOW}File:${NC} $FILE"
            echo -e "${YELLOW}Pattern:${NC} '$PATTERN'"
            echo -e "${YELLOW}Matches:${NC}"
            echo "$MATCHES" | head -3 | sed 's/^/    /'
            echo ""
        fi
    done
done

if [ $FOUND_PII -eq 1 ]; then
    echo -e "${RED}────────────────────────────────────────────────────────────${NC}"
    echo ""
    echo "To fix:"
    echo "  1. Remove or anonymize the PII in the files above"
    echo "  2. Stage the changes: git add <file>"
    echo "  3. Try committing again"
    echo ""
    echo "To bypass (use with caution):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo "✅ No PII patterns found"
exit 0
